 "standards": [
  {
   "name": "Two Sources",
   "rule": "Every key claim rests on two independent sources or one primary document.",
   "appliesTo": {
    "all": true
   }
  },
  {
   "name": "Primary First",
   "rule": "Link the original document: gazette, circular, filing, court order or dataset.",
   "appliesTo": {
    "all": true
   }
  },
  {
   "name": "No Hype",
   "rule": "Headline matches the body. No clickbait, no unverified superlatives.",
   "appliesTo": {
    "all": true
   }
  },
  {
   "name": "Clear Labels",
   "rule": "News, opinion, review and sponsored content are labelled as what they are.",
   "appliesTo": {
    "all": true
   }
  },
  {
   "name": "Open Corrections",
   "rule": "Errors are fixed in the open with a dated note; never silently edited.",
   "appliesTo": {
    "all": true
   }
  },
  {
   "name": "Verified Media",
   "rule": "Images and video checked for origin and date; AI-made visuals marked.",
   "appliesTo": {
    "media": true
   }
  },
  {
   "name": "Breaking Discipline",
   "rule": "Confirmed by an official or two sources before it is called Breaking; unconfirmed facts flagged.",
   "appliesTo": {
    "label": [
     "Breaking",
     "Developing"
    ]
   }
  },
  {
   "name": "Right of Reply",
   "rule": "Named people or organisations are asked to respond before publishing.",
   "appliesTo": {
    "section": [
     "Audits",
     "Policy"
    ],
    "cause": [
     "Accountability"
    ],
    "label": [
     "Exclusive",
     "Investigation"
    ]
   }
  },
  {
   "name": "Harm Check",
   "rule": "No personal data, victim identities or details that put people at risk.",
   "appliesTo": {
    "section": [
     "Safety",
     "Audits"
    ],
    "topic": [
     "Cybersecurity",
     "Privacy"
    ],
    "cause": [
     "Stay Safe",
     "Privacy First",
     "Child Safety"
    ]
   }
  },
  {
   "name": "Responsible Disclosure",
   "rule": "No working exploits or unpatched details; vendor or CERT contacted first.",
   "appliesTo": {
    "topic": [
     "Cybersecurity"
    ],
    "section": [
     "Safety",
     "Engineering"
    ],
    "cause": [
     "Cyber Resilience"
    ]
   }
  },
  {
   "name": "Action Steps",
   "rule": "Tells the audience exactly what to do next and where to get help.",
   "appliesTo": {
    "section": [
     "Safety",
     "Everyday"
    ],
    "cause": [
     "Stay Safe",
     "Consumer Rights",
     "Digital Literacy"
    ]
   }
  },
  {
   "name": "Expert Review",
   "rule": "Checked by a working practitioner in the field before publishing.",
   "appliesTo": {
    "section": [
     "Engineering",
     "Horizons"
    ],
    "format": [
     "Explainer",
     "Analysis"
    ],
    "cause": [
     "Expert Voice"
    ]
   }
  },
  {
   "name": "Data Integrity",
   "rule": "Method, source, date and units shown; no cherry-picked ranges.",
   "appliesTo": {
    "section": [
     "Data",
     "Economy"
    ],
    "format": [
     "Data"
    ],
    "cause": [
     "Open Data"
    ]
   }
  },
  {
   "name": "Plain Language",
   "rule": "Laws and technology explained for a non-expert; jargon defined.",
   "appliesTo": {
    "section": [
     "Policy",
     "Everyday"
    ],
    "format": [
     "Explainer"
    ],
    "cause": [
     "Plain Law",
     "Digital Literacy"
    ]
   }
  },
  {
   "name": "Fair Balance",
   "rule": "Credible opposing views included; our advocacy stated openly, never hidden.",
   "appliesTo": {
    "section": [
     "Policy",
     "Geopolitics"
    ],
    "format": [
     "Analysis",
     "Opinion"
    ],
    "cause": [
     "Digital Rights"
    ]
   }
  },
  {
   "name": "Conflict Disclosure",
   "rule": "Any tie to an advertiser, partner or product named in the piece is disclosed.",
   "appliesTo": {
    "format": [
     "Review"
    ],
    "section": [
     "Economy"
    ],
    "partner": true
   }
  },
  {
   "name": "Market Neutral",
   "rule": "No investment advice; we hold no position in what we cover.",
   "appliesTo": {
    "topic": [
     "Crypto",
     "Startups"
    ],
    "section": [
     "Economy"
    ],
    "audience": [
