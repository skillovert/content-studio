   "lines": [
    {
     "speaker": "Sara",
     "vo": "Istanbul sits on two continents, split by the Bosphorus strait between Europe and Asia.",
     "cue": "",
     "layout": "voice",
     "faceFor": 0,
     "graphic": {
      "type": "map",
      "kicker": "",
      "title": "TURKEY · WHERE IT IS",
      "items": [
       {
        "label": "Turkey",
        "value": "",
        "detail": "",
        "tone": "accent"
       },
       {
        "label": "Istanbul",
        "value": "Two continents",
        "detail": "41.01, 28.98",
        "tone": "neutral"
       }
      ],
      "lines": [],
      "stamp": "",
      "highlights": [],
      "sourceId": ""
     }
    },
    {
     "speaker": "Sara",
     "vo": "The old city, Sultanahmet, sits on the European side, and ferries cross to Asia every few minutes for about forty lira.",
     "cue": "",
     "layout": "voice",
     "faceFor": 0,
     "graphic": {
      "type": "footage",
      "kicker": "EUROPE · ASIA",
      "title": "Sultanahmet",
      "items": [
       {
        "label": "istanbul ferry bosphorus crossing",
        "value": "",
        "detail": "",
        "tone": "neutral"
       },
       {
